[Unit]
Description=SlideAI Telegram bot (long polling)
After=network-online.target postgresql.service
Wants=network-online.target
OnFailure=slideai-alert@%n.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
WorkingDirectory=/home/slideai-src/slideai/backend
EnvironmentFile=/home/slideai-src/slideai/backend/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/slideai-src/slideai/backend/.venv/bin/python polling.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
