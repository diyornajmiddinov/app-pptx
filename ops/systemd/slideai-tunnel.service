# Disabled on the server since the move to slidechi.uz (see ops/tunnel.py). Starting it rewrites backend/.env.
[Unit]
Description=SlideAI temporary HTTPS address (cloudflared quick tunnel)
After=network-online.target slideai-miniapp.service
Wants=network-online.target
OnFailure=slideai-alert@%n.service
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
WorkingDirectory=/home/slideai-src/slideai
EnvironmentFile=/home/slideai-src/slideai/backend/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/slideai-src/slideai/backend/.venv/bin/python ops/tunnel.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
