# Disabled on the server: nginx serves the built miniapp/dist at https://slidechi.uz/app/ (cd miniapp && npm run build).
# Only for development with a tunnel.
[Unit]
Description=SlideAI Mini App / editor / admin pages (Vite)
After=network-online.target
OnFailure=slideai-alert@%n.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
WorkingDirectory=/home/slideai-src/slideai/miniapp
ExecStart=/usr/bin/npx vite --host 127.0.0.1 --port 5173 --strictPort
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
