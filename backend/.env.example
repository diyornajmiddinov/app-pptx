# Copy to .env and fill in. Never commit .env.

# --- Telegram
BOT_TOKEN=123456:ABC...
WEBAPP_URL=https://miniapp.example.uz        # Mini App / editor / admin panel address (HTTPS)
PUBLIC_URL=https://miniapp.example.uz        # backend address for the webhook and Payme / Click callbacks
WEBHOOK_SECRET=change-me-random-string
ALLOWED_ORIGINS=https://miniapp.example.uz
ADMIN_IDS=123456789                          # comma-separated Telegram ids: /admin, card checks, /addbalance
LOG_CHANNEL_ID=                              # optional: channel for backups and error alerts (else set by adding the bot to a channel)

# --- Database (db.py)
DATABASE_URL=postgresql://slideai:password@127.0.0.1:5432/slideai

# --- Prices in so'm (the admin panel can override them)
PRICE_GENERATE=5000
PRICE_RESTYLE=2000
TOPUP_AMOUNTS=15000,30000,50000,100000

# --- Payments
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST=1
PAYME_ACCOUNT_FIELD=order_id
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYMENT_RETURN_URL=https://t.me/your_bot
CARD_NUMBER=
CARD_HOLDER=""

# --- AI and photos
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
PEXELS_API_KEY=
# ANTHROPIC_API_KEY=sk-ant-...               # used only when GEMINI_API_KEY is empty
# SLIDEAI_DEMO=1                             # test without AI and Pexels (uses engine/content/soliq.json)
