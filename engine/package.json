{
  "name": "slideai-engine",
  "private": true,
  "version": "2.0.0",
  "description": "SlideAI: 30 hand-designed PowerPoint templates and the filler that draws them",
  "main": "fill.js",
  "scripts": {
    "demo": "node fill.js 25 content/soliq.json",
    "demo:all": "for i in $(seq 1 30); do node fill.js $i content/soliq.json; done",
    "templates": "node -e \"console.log(JSON.stringify(require('./fill.js').TEMPLATES.map(t=>({id:t.id,name:t.name,category:t.category})),null,1))\""
  },
  "dependencies": {
    "opentype.js": "^1.3.4",
    "pptxgenjs": "^3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "sharp": "^0.33.5"
  }
}
